#!/bin/sh
# Pre-push guard: enforce CONTENT-STANDARDS §11 (no em dashes) before every push.
# A free-plan private repo cannot set required status checks / branch protection, so a
# failing workflow cannot block a merge. This local hook is the real gate.
# (Corrected 2026-07-27: this comment previously said GitHub Actions was billing-disabled.
# It is not. The "Verify Internal Links" workflow does run on every PR and on main, and it
# runs scripts/aeo-audit.mjs too. It just cannot be made blocking on this plan.) Auto-installed via the package.json postinstall
# (core.hooksPath=.githooks). Bypass in an emergency with: git push --no-verify
#
# ---------------------------------------------------------------------------
# Corrected 2026-08-04: this hook used to check the MUTABLE WORKING TREE.
#
# Every check read the filesystem, and the hook never read its stdin, so it
# could not know which commits were in flight. Reproduced end-to-end: commit an
# em dash, remove it in the working tree WITHOUT committing, push. The audit
# read the clean working copy, printed "PASS Section 11: 0 em dashes", exited 0,
# and git pushed the bad blob. The gate reported green on content that was not
# what was being pushed. Found by a Codex round-2 adversarial review 2026-08-03.
#
# The checks now run against each pushed commit's own tree, extracted into a
# temp dir by scripts/verify-pushed-tree.mjs. Deliberately NOT `git stash`: a
# stash that fails mid-way can lose uncommitted work, which is a worse failure
# than the one being fixed. Nothing here writes to the working tree.
#
# What this does NOT close: the commit that actually deploys is the squash-merge
# GitHub creates server-side, which never passes through any local hook. If main
# has moved since the branch was cut, the deployed tree is not the tree that was
# verified. And a local hook is a mistake-catcher, not a security boundary: a
# developer controls core.hooksPath, the scripts, and --no-verify.
# ---------------------------------------------------------------------------

# Where this hook lives. The orchestrator is resolved relative to THIS FILE, not
# to the working directory, because git runs hooks with cwd set to the PUSHING
# worktree's toplevel and this repo's checkouts do not all share one hook.
# (Verified 2026-08-04: extensions.worktreeConfig is true; 7 of 10 checkouts
# carry a per-worktree core.hooksPath pointing at the main checkout's .githooks,
# while main and two others use their own relative .githooks. `git rev-parse
# --git-path hooks/pre-push` does NOT model this and will mislead you.)
# Resolving from $0 keeps the hook and the orchestrator on the same side of that
# split, since the two are always committed together.
HOOK_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 1
VERIFIER="$HOOK_DIR/../scripts/verify-pushed-tree.mjs"

# Run by hand, `while read` below would block forever on the terminal.
if [ -t 0 ]; then
  echo "pre-push: this is a git hook and expects the ref list on stdin."
  echo "It is not meant to be run directly. To check a commit yourself:"
  echo "  node scripts/verify-pushed-tree.mjs \$(git rev-parse HEAD)"
  exit 1
fi

# Collect the tips being pushed, per the pre-push protocol:
#   <local ref> SP <local oid> SP <remote ref> SP <remote oid> LF
#
# Read to EOF BEFORE spawning anything, so no child can consume ref lines we
# have not parsed yet. `read -r` because a ref name may contain a backslash.
#
# The zero OID is computed rather than hardcoded (git's own idiom, from
# pre-push.sample) so this stays correct under SHA-256 repositories.
#
# Deletions carry the zero OID and have no tree to check.
#
# What is passed on is each ref TIP; the orchestrator expands that into every
# commit the push would add (`git rev-list <oid> --not --remotes`) and content
# checks each one, running the test suites once on the tip.
#
# (Corrected 2026-08-04, twice. The first draft verified tips only, justified by
# the claim that a brand-new ref gives no lower bound for a range because its
# remote OID is all zeros. That is wrong: --remotes bounds against every
# remote-tracking ref regardless of stdin. The gap was real, not theoretical --
# commit A with an em dash plus commit B repairing it pushed clean, and A's bad
# blob landed on the remote. Same failure this hook exists to stop, so it is
# closed rather than documented.)
ZERO=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
SHAS=""
MAIN_ARGS=""
COUNT=0
while read -r _local_ref local_oid remote_ref _remote_oid; do
  [ -n "$local_oid" ] || continue
  [ "$local_oid" != "$ZERO" ] || continue

  # Which tips LAND ON main. Decided by the REMOTE ref, never the local one:
  # `git push origin HEAD:refs/heads/main` has a local ref of HEAD, and scoping
  # off the local name would both miss that and fire wrongly on a local branch
  # called main being pushed somewhere else.
  #
  # Recorded BEFORE the dedup below, deliberately. The dedup exists so a tip
  # pushed to two refs is verified once, but it `continue`s -- so a tip pushed to
  # some other ref first and to main second would be skipped here and never
  # linted. Order matters; do not fold this into the block below.
  if [ "$remote_ref" = "refs/heads/main" ]; then
    case " $MAIN_ARGS " in
      *" $local_oid "*) ;;
      *) MAIN_ARGS="$MAIN_ARGS --main-tip $local_oid" ;;
    esac
  fi

  case " $SHAS " in
    *" $local_oid "*) continue ;;   # same tip pushed to two refs; verify once
  esac
  SHAS="$SHAS $local_oid"
  COUNT=$((COUNT + 1))
done

# Nothing to verify is a LEGITIMATE success, not a skipped check. A delete-only
# push (git push --delete) reaches here with no OIDs and must be allowed. This
# is the one place the two are distinguished; the orchestrator itself refuses to
# report success when handed no arguments.
if [ "$COUNT" -eq 0 ]; then
  echo "pre-push: nothing to verify (no non-deletion refs in this push)."
  exit 0
fi

if [ "$SKIP_ARCHIVE_VERIFY" != "1" ] && [ -f "$VERIFIER" ]; then
  # Word splitting on $SHAS and $MAIN_ARGS is intentional: both are
  # space-separated lists of literal tokens, each passed as its own argument.
  #
  # --main-tips-declared is passed UNCONDITIONALLY, including when no tip lands
  # on main. It is what lets the orchestrator tell "this push is not going to
  # main" apart from "this hook is too old to know" -- without it, a version-
  # skewed checkout would silently disable the CLAUDE.md lint instead of saying
  # so, which is the quiet fail-open this whole file exists to end.
  # shellcheck disable=SC2086
  node "$VERIFIER" --main-tips-declared $MAIN_ARGS $SHAS
  exit $?
fi

# The degraded path below runs NONE of the orchestrator's checks, the CLAUDE.md
# directive lint included. Everything about that lint insists a skip must be
# visible or it is a lie -- and this was the one route that skipped it in
# silence, because the valve that gets here is a different one
# (SKIP_ARCHIVE_VERIFY), it is what extractTree's own failure message tells
# people to reach for, and the degraded banner talks only about the working
# tree. Say it here, and only when a tip actually lands on main, so the line
# means something when it appears.
if [ -n "$MAIN_ARGS" ]; then
  echo ""
  echo "CLAUDE_MD_LINT_SKIPPED: this push lands on main, but the archive verifier did not"
  echo "  run, so the CLAUDE.md directive-file lint did not either. Nothing checked that the"
  echo "  commands this repo's rules name still resolve."
fi

# ---------------------------------------------------------------------------
# Degraded path. Reached when the orchestrator is absent (a checkout whose
# branch predates it) or when it is switched off deliberately.
#
# This knowingly reinstates the bug described above. It is still the right
# default: blocking every push in the repo is worse, and CLAUDE.md bans
# --no-verify, so there would be no way out. It is loud so it cannot be mistaken
# for a clean run.
# ---------------------------------------------------------------------------
# On stderr, not stdout: this warning has to survive `git push >log`, or the
# one run that silently reverted to the old behaviour is the one nobody sees.
echo "###########################################################" >&2
echo "# pre-push: DEGRADED MODE                                 #" >&2
echo "# Checking the WORKING TREE, not the commits being pushed. #" >&2
echo "# A violation that is COMMITTED but fixed in your working  #" >&2
echo "# tree will NOT be caught.                                 #" >&2
echo "###########################################################" >&2
if [ "$SKIP_ARCHIVE_VERIFY" != "1" ]; then
  echo "Reason: $VERIFIER not found." >&2
fi

if ! node scripts/aeo-audit.mjs; then
  echo ""
  echo "PUSH BLOCKED: content audit failed (see details above). Common causes:"
  echo "  - em dashes (CONTENT-STANDARDS section 11): remove them, or mark a"
  echo "    genuinely-functional one with the token: emdash-allow"
  echo "  - a metaTitle / article frontmatter title that hard-codes the brand"
  echo "    (the title template already appends it): remove the brand suffix"
  exit 1
fi

# Article frontmatter dates. Separate from the unit suites below on purpose: those run
# against temp-directory fixtures and prove the CHECKER works, while this runs the checker
# against the real content/articles corpus and is the only thing that proves the ARTICLES
# are clean. A date that is missing, unquoted, or not a real calendar day fails here.
#
# Unquoted is a failure even when the day is valid, because js-yaml resolves a bare
# YYYY-MM-DD into a Date and silently rolls over impossible days before any app code runs
# (2026-02-30 becomes March 2). By then the authored value is gone, so this is the last
# point at which the mistake is still visible.
if ! node scripts/verify-dates.mjs; then
  echo ""
  echo "PUSH BLOCKED: an article frontmatter date is missing, unquoted, or not a real day."
  echo "  Quote it:  date: \"2026-02-28\"   (single quotes are fine too)"
  echo "  Re-check:  npm run verify-dates"
  exit 1
fi

# Brand-identity map drift. The map is generated from a registry in the brand-intelligence-pipeline
# repo, so the realistic failure is that the registry moves and the committed artifact does not,
# after which imports refuse brands that genuinely exist. Skipped, loudly, when that repo is not
# checked out on this machine, since it is a sibling repo and not every clone will have it.
#
# That skip lives in the script (`registryAvailability`), not here, so this hook and the drift test
# cannot drift apart. --check exits 0 with a BRAND_MAP_DRIFT_SKIPPED warning in exactly the
# absent-repo case, and 1 for a stale map, a moved registry, or a bad BIP_REGISTRY_PATH.
# (Corrected 2026-08-02: this comment claimed the skip already existed. It did not. --check exited
# 1 whenever the registry was unreadable, so every push from a machine without the sibling repo was
# blocked.)
#
# SKIP_BIP_DRIFT is tested for exactly "1", the documented form, because the drift test tests for
# exactly "1" too. This used to be `-z`, so SKIP_BIP_DRIFT=0 disabled the push guard while the test
# still ran it: one variable, two meanings, and the value that reads like "off" turned it off.
#
# Output is captured rather than discarded. The routine "in sync" line is noise on every green push,
# but on a failure it carries the registry version and hashes, which is the fastest way to tell
# whether the registry moved forward or the map went backward. Quiet when green, everything when not.
if [ "$SKIP_BIP_DRIFT" != "1" ]; then
  drift_output=$(node scripts/build-brand-map.mjs --check 2>&1)
  drift_status=$?
  if [ "$drift_status" -ne 0 ]; then
    echo "$drift_output"
    echo ""
    echo "PUSH BLOCKED: the committed brand-identity map is stale or unverifiable."
    echo "  Regenerate and review the diff:  node scripts/build-brand-map.mjs"
    echo "  Genuinely need to skip?          SKIP_BIP_DRIFT=1 git push"
    exit 1
  fi
  # Green, but green-because-skipped has to be visible or the skip is a lie.
  case "$drift_output" in
    *BRAND_MAP_DRIFT_SKIPPED*) echo "$drift_output" ;;
  esac
fi

# Fast unit suites (no database, no network). These were previously run by nothing:
# CI executes only verify-links + aeo-audit, and npm test was two .mjs verifiers, so
# the route/background-work and auth-coverage guards could rot unnoticed. Skipped,
# loudly, when vitest is not installed, since a fresh clone has no node_modules yet.
#
# Corrected 2026-08-04: this was `[ -z "$SKIP_UNIT_TESTS" ]`, so SKIP_UNIT_TESTS=0
# silently disabled the suites. Exactly the bug already fixed for SKIP_BIP_DRIFT
# above, left behind when that one was corrected. Both now test for exactly "1".
if [ "$SKIP_UNIT_TESTS" != "1" ]; then
  if [ -x "node_modules/.bin/vitest" ]; then
    if ! node_modules/.bin/vitest run --project unit --project auth; then
      echo ""
      echo "PUSH BLOCKED: unit tests failed (see above)."
      echo "  Run them directly:  npm run test:unit && npm run test:auth"
      echo "  Genuinely need to skip?  SKIP_UNIT_TESTS=1 git push"
      exit 1
    fi
  else
    echo "NOTE: vitest not installed, skipping unit suites. Run 'npm install' to enable them."
  fi
fi
