#!/bin/sh
# Pre-push guard: enforce CONTENT-STANDARDS §11 (no em dashes) before every push.
# A free-plan private repo cannot set required status checks / branch protection, so a
# failing workflow cannot block a merge. This local hook is the real gate.
# (Corrected 2026-07-27: this comment previously said GitHub Actions was billing-disabled.
# It is not. The "Verify Internal Links" workflow does run on every PR and on main, and it
# runs scripts/aeo-audit.mjs too. It just cannot be made blocking on this plan.) Auto-installed via the package.json postinstall
# (core.hooksPath=.githooks). Bypass in an emergency with: git push --no-verify
if ! node scripts/aeo-audit.mjs; then
  echo ""
  echo "PUSH BLOCKED: content audit failed (see details above). Common causes:"
  echo "  - em dashes (CONTENT-STANDARDS section 11): remove them, or mark a"
  echo "    genuinely-functional one with the token: emdash-allow"
  echo "  - a metaTitle / article frontmatter title that hard-codes the brand"
  echo "    (the title template already appends it): remove the brand suffix"
  exit 1
fi

# Article frontmatter dates. Separate from the unit suites below on purpose: those run
# against temp-directory fixtures and prove the CHECKER works, while this runs the checker
# against the real content/articles corpus and is the only thing that proves the ARTICLES
# are clean. A date that is missing, unquoted, or not a real calendar day fails here.
#
# Unquoted is a failure even when the day is valid, because js-yaml resolves a bare
# YYYY-MM-DD into a Date and silently rolls over impossible days before any app code runs
# (2026-02-30 becomes March 2). By then the authored value is gone, so this is the last
# point at which the mistake is still visible.
if ! node scripts/verify-dates.mjs; then
  echo ""
  echo "PUSH BLOCKED: an article frontmatter date is missing, unquoted, or not a real day."
  echo "  Quote it:  date: \"2026-02-28\"   (single quotes are fine too)"
  echo "  Re-check:  npm run verify-dates"
  exit 1
fi

# Brand-identity map drift. The map is generated from a registry in the brand-intelligence-pipeline
# repo, so the realistic failure is that the registry moves and the committed artifact does not,
# after which imports refuse brands that genuinely exist. Skipped, loudly, when that repo is not
# checked out on this machine, since it is a sibling repo and not every clone will have it.
#
# That skip lives in the script (`registryAvailability`), not here, so this hook and the drift test
# cannot drift apart. --check exits 0 with a BRAND_MAP_DRIFT_SKIPPED warning in exactly the
# absent-repo case, and 1 for a stale map, a moved registry, or a bad BIP_REGISTRY_PATH.
# (Corrected 2026-08-02: this comment claimed the skip already existed. It did not. --check exited
# 1 whenever the registry was unreadable, so every push from a machine without the sibling repo was
# blocked.)
#
# SKIP_BIP_DRIFT is tested for exactly "1", the documented form, because the drift test tests for
# exactly "1" too. This used to be `-z`, so SKIP_BIP_DRIFT=0 disabled the push guard while the test
# still ran it: one variable, two meanings, and the value that reads like "off" turned it off.
#
# Output is captured rather than discarded. The routine "in sync" line is noise on every green push,
# but on a failure it carries the registry version and hashes, which is the fastest way to tell
# whether the registry moved forward or the map went backward. Quiet when green, everything when not.
if [ "$SKIP_BIP_DRIFT" != "1" ]; then
  drift_output=$(node scripts/build-brand-map.mjs --check 2>&1)
  drift_status=$?
  if [ "$drift_status" -ne 0 ]; then
    echo "$drift_output"
    echo ""
    echo "PUSH BLOCKED: the committed brand-identity map is stale or unverifiable."
    echo "  Regenerate and review the diff:  node scripts/build-brand-map.mjs"
    echo "  Genuinely need to skip?          SKIP_BIP_DRIFT=1 git push"
    exit 1
  fi
  # Green, but green-because-skipped has to be visible or the skip is a lie.
  case "$drift_output" in
    *BRAND_MAP_DRIFT_SKIPPED*) echo "$drift_output" ;;
  esac
fi

# Fast unit suites (no database, no network). These were previously run by nothing:
# CI executes only verify-links + aeo-audit, and npm test was two .mjs verifiers, so
# the route/background-work and auth-coverage guards could rot unnoticed. Skipped,
# loudly, when vitest is not installed, since a fresh clone has no node_modules yet.
if [ -z "$SKIP_UNIT_TESTS" ]; then
  if [ -x "node_modules/.bin/vitest" ]; then
    if ! node_modules/.bin/vitest run --project unit --project auth; then
      echo ""
      echo "PUSH BLOCKED: unit tests failed (see above)."
      echo "  Run them directly:  npm run test:unit && npm run test:auth"
      echo "  Genuinely need to skip?  SKIP_UNIT_TESTS=1 git push"
      exit 1
    fi
  else
    echo "NOTE: vitest not installed, skipping unit suites. Run 'npm install' to enable them."
  fi
fi
