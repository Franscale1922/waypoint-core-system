{
  "name": "velvet-armstrong",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm install remark-gfm && prisma generate && node scripts/guard-immutable-tables.mjs && prisma db push && next build",
    "build:check": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate && (git config core.hooksPath .githooks || true)",
    "gsc-report": "node scripts/gsc-report.mjs",
    "ai-citation-check": "node scripts/ai-citation-check.mjs",
    "aeo-audit": "node scripts/aeo-audit.mjs",
    "verify-schema": "node scripts/verify-schema.mjs",
    "codex-review": "node scripts/codex-review.mjs",
    "seo-review": "node scripts/gsc-report.mjs && node scripts/ai-citation-check.mjs",
    "test": "node scripts/verify-links.mjs && node scripts/verify-schema.mjs && npm run test:unit && npm run test:auth && node scripts/build-brand-map.mjs --check",
    "test:unit": "vitest run --project unit",
    "test:links": "vitest run --project unit tests/unit/verify-links.test.ts && node scripts/verify-links.mjs",
    "test:auth": "vitest run --project auth",
    "test:match-workspace": "vitest run --project match-workspace"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@anthropic-ai/sdk": "^0.95.1",
    "@tailwindcss/typography": "^0.5.19",
    "ai": "^6.0.116",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "inngest": "^3.54.0",
    "lucide-react": "^0.577.0",
    "next": "16.2.4",
    "next-auth": "^5.0.0-beta.30",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remark-gfm": "^4.0.0",
    "resend": "^6.9.3",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "googleapis": "^171.4.0",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "browserslist": [
    "chrome >= 107",
    "firefox >= 104",
    "safari >= 15.6",
    "edge >= 107"
  ]
}
